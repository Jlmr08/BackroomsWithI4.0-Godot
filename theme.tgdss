@global var color_bg: "#0a0e1a"
@global var color_border: "#1a2332"
@global var yellow1: "#d4af37"
@global var text_color: "#e0e0e0"
@global var hover_color: "#151b29"
@global var color_hover_border: "#1a6dd4"
@global var text_bright: "#aabbcc"

Button {
	padding: 12 16 12 16
	border: 2 2 2 2
	bg_color: $color_bg 
	border_color: $color_border 
	font_size: 24
	cursor: POINTING
	
	transition_time: 0.2
	transition_func: QUAD
	transition_type: EASE_IN_OUT
}

Button:pressed {
	border_color: $yellow1
	bg_color: $color_border 
	font_color: $text_color 
	font_size: 24
}

Button:hover {
	border_color: $color_hover_border 
	font_color: $text_bright 
}

Button:disabled {
	
}